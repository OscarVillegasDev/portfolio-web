---
// src/components/EndpointView.astro
import TabsNav from "./TabsNav.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { DATA_404 } from "../data/404.js";

export interface Props {
    endpointTitle: string;
    dataToShow: any;
    isHomePage?: boolean;
    copyableFields?: string[];
    showMoreConfig?: object;
}
const {
    endpointTitle,
    dataToShow,
    isHomePage = false,
    copyableFields = [],
    showMoreConfig = {},
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const clientStrings = {
    sending: t("sending_button"),
    send: t("send_button"),
    statusReady: t("status_ready"),
    statusSending: t("status_sending"),
    statusOk: t("status_ok"),
    status404: t("status_404"),
    errorVerb: t("errorVerb"),
    errorUrl: t("errorUrl"),
    responseTime: t("response_time_label"),
    responseSize: t("response_size_label"),
    pressSend: t("press_send_comment"),
    copySuccess: t("copy_message_success"),
    moreItems: t("show_more_items_comment"),
    // Traducciones para el tour
    tourStep1Title: t("tour_step1_title"),
    tourStep1Desc: t("tour_step1_desc"),
    tourStep2Title: t("tour_step2_title"),
    tourStep2Desc: t("tour_step2_desc"),
    tourStep3Title: t("tour_step3_title"),
    tourStep3Desc: t("tour_step3_desc"),
    tourStep4Title: t("tour_step4_title"),
    tourStep4Desc: t("tour_step4_desc"),
    tourStep5Title: t("tour_step5_title"),
    tourStep5Desc: t("tour_step5_desc"),
    tourStep6Title: t("tour_step6_title"),
    tourStep6Desc: t("tour_step6_desc"),
    tourStep7Title: t("tour_step7_title"),
    tourStep7Desc: t("tour_step7_desc"),
    tourStep8Title: t("tour_step8_title"),
    tourStep8Desc: t("tour_step8_desc"),
    tourStep9Title: t("tour_step9_title"),
    tourStep9Desc: t("tour_step9_desc"),
    tourStep10Title: t("tour_step10_title"),
    tourStep10Desc: t("tour_step10_desc"),
};
---

<div class="postman-container">
    <TabsNav />
    <div class="request-bar">
        <select
            id="method-select"
            class="method-select"
            aria-label="HTTP Method"
            ><option>GET</option><option disabled>POST</option>
            <option disabled>PUT</option>
            <option disabled>DELETE</option></select
        >
        <input
            id="url-input"
            type="text"
            class="url-input"
            value={`https://airashistudio.dev/api/oscar-villegas/v1/${endpointTitle.toLowerCase()}`}
            readonly
        />
        <button id="send-button" class="send-button">{t("send_button")}</button>
    </div>

    <div class="tabs" role="tablist">
        <div
            class="tab active"
            data-tab="params"
            role="tab"
            aria-selected="true"
            aria-controls="params-content"
        >
            {t("request_tab_params")}
        </div>
        <div
            class="tab"
            data-tab="headers"
            role="tab"
            aria-selected="false"
            aria-controls="headers-content"
        >
            Headers (0)
        </div>
        <div
            class="tab"
            data-tab="body"
            role="tab"
            aria-selected="false"
            aria-controls="body-content"
        >
            Body
        </div>
        <div
            class="tab"
            data-tab="scripts"
            role="tab"
            aria-selected="false"
            aria-controls="scripts-content"
        >
            Scripts
        </div>
        <div
            class="tab"
            data-tab="settings"
            role="tab"
            aria-selected="false"
            aria-controls="settings-content"
        >
            {t("request_tab_settings")}
        </div>
    </div>

    <div class="tab-content-container">
        <div
            class="tab-content active"
            id="params-content"
            role="tabpanel"
            aria-labelledby="params"
        >
            <p class="no-body-message">{t("params_content")}</p>
        </div>
        <div
            class="tab-content"
            id="headers-content"
            role="tabpanel"
            aria-labelledby="headers"
            style="display: none;"
        >
            <p class="no-body-message">{t("headers_content")}</p>
        </div>
        <div
            class="tab-content"
            id="body-content"
            role="tabpanel"
            aria-labelledby="body"
            style="display: none;"
        >
            <p class="no-body-message">{t("body_content_get")}</p>
        </div>
        <div
            class="tab-content"
            id="scripts-content"
            role="tabpanel"
            aria-labelledby="scripts"
            style="display: none;"
        >
            <p class="no-body-message">{t("scripts_content")}</p>
        </div>
        <div
            class="tab-content"
            id="settings-content"
            role="tabpanel"
            aria-labelledby="settings"
            style="display: none;"
        >
            <p class="no-body-message">{t("settings_content")}</p>
        </div>
    </div>

    <div class="response-section">
        <div class="response-header">
            <span class="response-title">{t("response_title")}</span>
            <div class="response-details">
                <span id="status-code" class="status-code"
                    >{t("status_ready")}</span
                >
                <span id="response-time" class="response-time"></span>
                <span id="response-size" class="response-size"></span>
            </div>
        </div>
        <div class="response-body">
            <pre
                id="json-display"
                class="json-comment-line">{t('press_send_comment')}</pre>
        </div>
    </div>
</div>

<div id="copy-message" class="copy-message"></div>

<div id="image-reel-modal" class="image-reel-modal" style="display: none;">
    <span id="close-reel" class="close-reel">&times;</span>
    <div class="reel-content">
        <img id="reel-image" src="" alt="Project image" />
        <a id="prev-reel" class="prev-reel">&#10094;</a>
        <a id="next-reel" class="next-reel">&#10095;</a>
    </div>
</div>

<script
    define:vars={{
        dataToShow,
        clientStrings,
        isHomePage,
        copyableFields,
        showMoreConfig,
        DATA_404,
        endpointTitle,
    }}
>
    class EndpointViewer {
        constructor(
            data,
            strings,
            isHomePage,
            copyableFields,
            showMoreConfig,
            endpointTitle,
        ) {
            this.data = data;
            this.strings = strings;
            this.isHomePage = isHomePage;
            this.endpointTitle = endpointTitle;

            this.FIELDS_TO_COPY_AND_STYLE = copyableFields;
            this.RESUME_PDF_PATH = "details.cvPdf";
            this.SHOW_MORE_CONFIG = showMoreConfig;
            this.expandedSections = {};

            this.sendButton = document.getElementById("send-button");
            this.jsonDisplay = document.getElementById("json-display");
            this.copyMessageDiv = document.getElementById("copy-message");
            this.statusCodeSpan = document.getElementById("status-code");
            this.responseTimeSpan = document.getElementById("response-time");
            this.responseSizeSpan = document.getElementById("response-size");
            this.tabButtons = document.querySelectorAll(".tab");
            this.tabContents = document.querySelectorAll(".tab-content");
            this.selectVerb = document.getElementById("method-select");

            // Image Reel elements
            this.imageReelModal = document.getElementById("image-reel-modal");
            this.reelImage = document.getElementById("reel-image");
            this.closeReelButton = document.getElementById("close-reel");
            this.prevReelButton = document.getElementById("prev-reel");
            this.nextReelButton = document.getElementById("next-reel");
            this.reelImages = [];
            this.currentReelIndex = 0;
            this.reelInterval = null;
            this.touchStartX = 0;
            this.touchEndX = 0;

            this.DATA_404 = DATA_404;
            this.driverObj = null;

            this.init();
        }

        init() {
            this.sendButton.addEventListener("click", () =>
                this.sendApiRequest(),
            );
            this.startTour();
            
            this.tabButtons.forEach((tab) => {
                tab.addEventListener("click", this.handleTabClick.bind(this));
            });

            this.tourTabLinks = document.querySelectorAll(".endpoint-tab");
            this.tourTabLinks.forEach((link) => {
                link.addEventListener("click", (e) =>
                    this.handleTourLinkClick(e),
                );
            });

            // Image Reel listeners
            this.closeReelButton.addEventListener("click", () => this.closeImageReel());
            this.imageReelModal.addEventListener("click", (e) => {
                if (e.target === this.imageReelModal) {
                    this.closeImageReel();
                }
            });
            this.prevReelButton.addEventListener("click", () => this.showPrevImage());
            this.nextReelButton.addEventListener("click", () => this.showNextImage());

            const reelContent = this.imageReelModal.querySelector('.reel-content');
            reelContent.addEventListener('touchstart', (e) => {
                this.touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            reelContent.addEventListener('touchend', (e) => {
                this.touchEndX = e.changedTouches[0].screenX;
                this.handleSwipeGesture();
            });
        }

        sendApiRequest() {
            this.sendButton.disabled = true;
            this.sendButton.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ${this.strings.sending}`;
            this.statusCodeSpan.textContent = this.strings.statusSending;
            this.responseTimeSpan.textContent = "";
            this.responseSizeSpan.textContent = "";
            this.jsonDisplay.textContent = "";

            setTimeout(() => {
                this.updateResponseDetails(this.selectVerb.value);
                this.sendButton.disabled = false;
                this.sendButton.textContent = this.strings.send;
            }, 800);
        }

        updateResponseDetails(verb) {
            const time = Math.floor(Math.random() * (250 - 50 + 1)) + 50;
            const size = (
                new TextEncoder().encode(JSON.stringify(this.data)).length /
                1024
            ).toFixed(2);
            this.responseTimeSpan.textContent = `${this.strings.responseTime}: ${time} ms`;
            this.responseSizeSpan.textContent = `${this.strings.responseSize}: ${size} KB`;
            const urlInput = document.querySelector(".url-input");
            const currentUrl = urlInput ? urlInput.value : "";
            if (
                verb === "GET" &&
                currentUrl ===
                    `https://airashistudio.dev/api/oscar-villegas/v1/${endpointTitle.toLowerCase()}`
            ) {
                this.statusCodeSpan.textContent = this.strings.statusOk;
                this.statusCodeSpan.style.color = "#B5CEA8";
                this.renderPortfolioJson();
            } else {
                let errorMessage = [];

                if (
                    currentUrl !=
                    `https://airashistudio.dev/api/oscar-villegas/v1/${endpointTitle.toLowerCase()}`
                ) {
                    errorMessage.push(`${this.strings.errorUrl}`);
                }
                if (verb != "GET") {
                    errorMessage.push(`${this.strings.errorVerb}`);
                }
                this.statusCodeSpan.textContent = this.strings.status404;
                this.statusCodeSpan.style.color = "#F04747";
                this.renderPortfolioJson404(errorMessage);
            }
        }

        renderPortfolioJson404(errorMessage) {
            if (!this.DATA_404) return;
            this.DATA_404.details = [];
            this.DATA_404.details.push(errorMessage);

            this.jsonDisplay.innerHTML = this.highlightAndFoldJson(
                this.DATA_404,
                this.FIELDS_TO_COPY_AND_STYLE, // Mantén esto si quieres que los campos del 404 sean copiables
            );
            // Si el JSON 404 tiene elementos plegables o copiables, asegúrate de que sus event listeners se adjunten
            this.jsonDisplay
                .querySelectorAll(".json-foldable-toggle")
                .forEach((t) =>
                    t.addEventListener("click", (e) =>
                        this.handleFoldToggle(e),
                    ),
                );
            this.jsonDisplay
                .querySelectorAll(".json-copyable-field")
                .forEach((e) =>
                    e.addEventListener("click", (ev) =>
                        this.handleJsonContentClick(ev),
                    ),
                );
            this.jsonDisplay
                .querySelectorAll(".show-more-button")
                .forEach((b) =>
                    b.addEventListener("click", (e) =>
                        this.handleShowMoreClick(e),
                    ),
                );
        }

        renderPortfolioJson() {
            if (!this.data) return;
            this.jsonDisplay.innerHTML = this.highlightAndFoldJson(
                this.data,
                this.FIELDS_TO_COPY_AND_STYLE,
            );
            this.jsonDisplay
                .querySelectorAll(".json-foldable-toggle")
                .forEach((t) =>
                    t.addEventListener("click", (e) =>
                        this.handleFoldToggle(e),
                    ),
                );
            this.jsonDisplay
                .querySelectorAll(".json-copyable-field")
                .forEach((e) =>
                    e.addEventListener("click", (ev) =>
                        this.handleJsonContentClick(ev),
                    ),
                );
            this.jsonDisplay
                .querySelectorAll(".show-more-button")
                .forEach((b) =>
                    b.addEventListener("click", (e) =>
                        this.handleShowMoreClick(e),
                    ),
                );
            
            this.jsonDisplay
                .querySelectorAll(".json-highlights-reel")
                .forEach((el) =>
                    el.addEventListener("click", (e) =>
                        this.handleHighlightsClick(e),
                    ),
                );
        }

        highlightAndFoldJson(
            data,
            fieldsToStyle,
            currentPath = "",
            indentLevel = 0,
        ) {
            const indent = " ".repeat(indentLevel * 4);

            if (data === null) {
                return `<span class="null">null</span>`;
            }

            if (Array.isArray(data)) {
                // Filtra los elementos undefined/null al principio para asegurar que solo procesas elementos válidos
                const filteredData = data.filter(
                    (item) => item !== undefined && item !== null,
                );

                const config = this.SHOW_MORE_CONFIG[currentPath];
                const isExpanded = this.expandedSections[currentPath] || false;

                // Usa la longitud de los datos filtrados para displayLimit
                const actualDisplayLimit =
                    config && !isExpanded && config.limit < filteredData.length
                        ? config.limit
                        : filteredData.length;

                const remainingItems = filteredData.length - actualDisplayLimit;

                let html = "";
                if (currentPath && filteredData.length > 0) {
                    html += `<span class="json-foldable-toggle">▾</span>`;
                }
                html += `<span class="json-bracket">[</span>\n<span class="json-folded-content">`;

                for (let i = 0; i < actualDisplayLimit; i++) {
                    const item = filteredData[i]; // Itera sobre los datos filtrados
                    const itemPath = `${currentPath}[${i}]`; // La ruta del path aún puede basarse en el índice original si es relevante

                    html += `${" ".repeat((indentLevel + 1) * 4)}${this.highlightAndFoldJson(item, fieldsToStyle, itemPath, indentLevel + 1)}`;

                    // Añadir coma solo si NO es el último elemento visible y real
                    if (i < actualDisplayLimit - 1) {
                        html += ",\n";
                    } else if (config && remainingItems > 0 && !isExpanded) {
                        // Caso especial: si es el último elemento visible y habrá un botón "show more"
                        html += ",\n";
                    } else {
                        html += "\n";
                    }
                }
                html += `</span>`;

                if (config && filteredData.length > config.limit) {
                    // Usa filteredData.length aquí también
                    const buttonText = isExpanded ? "[-]" : "[+]";
                    const buttonLineIndent = " ".repeat((indentLevel + 1) * 4);
                    if (!isExpanded) {
                        html += `${buttonLineIndent}<span class="json-comment-line">${this.strings.moreItems.replace("%s", remainingItems)}</span>\n`;
                    }
                    html += `${buttonLineIndent}<button class="show-more-button" data-path="${currentPath}">${buttonText}</button>\n`;
                }

                html += `${indent}<span class="json-bracket">]</span>`;
                return html;
            }

            if (typeof data === "object") {
                const keys = Object.keys(data);
                let html = "";
                if (keys.length > 0) {
                    html += `<span class="json-foldable-toggle">▾</span>`;
                }
                html += `<span class="json-bracket">{</span>\n<span class="json-folded-content">`;

                keys.forEach((key, index) => {
                    const value = data[key];
                    const keyPath = currentPath ? `${currentPath}.${key}` : key;
                    const valueIndent = " ".repeat((indentLevel + 1) * 4);

                    if (key === 'highlights' && Array.isArray(value) && value.length > 0) {
                        html += `${valueIndent}<span class="key">"${key}"</span>: <span class="json-highlights-reel" data-images='${JSON.stringify(value)}'>[View Images]</span>`;
                    } else {
                        html += `${valueIndent}<span class="key">"${key}"</span>: ${this.highlightAndFoldJson(value, fieldsToStyle, keyPath, indentLevel + 1)}`;
                    }
                    
                    if (index < keys.length - 1) {
                        html += ",\n";
                    }
                });

                html += `\n</span>${indent}<span class="json-bracket">}</span>`;
                return html;
            }

            if (typeof data === "string") {
                const isCopiable = fieldsToStyle.includes(currentPath);
                const isPdfLink = currentPath === this.RESUME_PDF_PATH;
                if (isPdfLink) {
                    return `<span class="string"><a href="${data}" target="_blank" rel="noopener noreferrer" class="json-pdf-link">${JSON.stringify(data)}</a></span>`;
                }
                if (isCopiable) {
                    return `<span class="string"><span class="json-copyable-field" data-copy-text="${data}">${JSON.stringify(data)}</span></span>`;
                }
                return `<span class="string">${JSON.stringify(data)}</span>`;
            }
            if (typeof data === "number")
                return `<span class="number">${data}</span>`;
            if (typeof data === "boolean")
                return `<span class="boolean">${data}</span>`;

            return "";
        }

        handleTabClick(event) {
            // Get the clicked tab button from the event
            const clickedTab = event.currentTarget;
            const targetTabId = clickedTab.dataset.tab + "-content";

            // Deactivate all tabs
            this.tabButtons.forEach((tab) => {
                tab.classList.remove("active");
                tab.setAttribute("aria-selected", "false");
            });

            // Activate the clicked tab
            clickedTab.classList.add("active");
            clickedTab.setAttribute("aria-selected", "true");

            // Hide all tab contents
            this.tabContents.forEach((content) => {
                content.style.display = "none";
                content.setAttribute("aria-hidden", "true"); // Add for accessibility
            });

            // Show the target tab content
            const activeContent = document.getElementById(targetTabId);
            if (activeContent) {
                activeContent.style.display = "block";
                activeContent.setAttribute("aria-hidden", "false"); // Add for accessibility
            }
        }

        handleFoldToggle(event) {
            const target = event.currentTarget;
            const content = target.nextElementSibling.nextElementSibling;
            if (content?.classList.contains("json-folded-content")) {
                content.classList.toggle("hidden");
                target.textContent = content.classList.contains("hidden")
                    ? "▸"
                    : "▾";
            }
        }

        handleJsonContentClick(event) {
            const target = event.currentTarget;
            this.handleCopyToClipboard(
                target.dataset.copyText || target.textContent,
                target,
            );
        }

        handleShowMoreClick(event) {
            const button = event.currentTarget;
            this.expandedSections[button.dataset.path] =
                !this.expandedSections[button.dataset.path];
            this.renderPortfolioJson();
        }

        handleCopyToClipboard(text, element) {
            navigator.clipboard.writeText(text).then(() => {
                this.copyMessageDiv.textContent = this.strings.copySuccess;
                const rect = element.getBoundingClientRect();
                this.copyMessageDiv.style.top = `${rect.top - 30}px`;
                this.copyMessageDiv.style.left = `${rect.left + rect.width / 2}px`;
                this.copyMessageDiv.classList.add("show");
                setTimeout(
                    () => this.copyMessageDiv.classList.remove("show"),
                    1500,
                );
            });
        }

        handleHighlightsClick(event) {
            const images = JSON.parse(event.currentTarget.dataset.images);
            this.openImageReel(images);
        }

        openImageReel(images) {
            this.reelImages = images;
            this.currentReelIndex = 0;
            this.updateReelImage();
            this.imageReelModal.style.display = "flex";
            document.body.style.overflow = "hidden";
            this.startReelInterval();
        }

        closeImageReel() {
            this.imageReelModal.style.display = "none";
            document.body.style.overflow = "auto";
            this.stopReelInterval();
        }

        updateReelImage() {
            if (this.reelImages.length > 0) {
                this.reelImage.src = this.reelImages[this.currentReelIndex];
            }
        }

        showNextImage() {
            if (this.reelImages.length === 0) return;
            this.currentReelIndex = (this.currentReelIndex + 1) % this.reelImages.length;
            this.updateReelImage();
            this.resetReelInterval();
        }

        showPrevImage() {
            if (this.reelImages.length === 0) return;
            this.currentReelIndex = (this.currentReelIndex - 1 + this.reelImages.length) % this.reelImages.length;
            this.updateReelImage();
            this.resetReelInterval();
        }

        startReelInterval() {
            this.stopReelInterval();
            this.reelInterval = setInterval(() => this.showNextImage(), 5000);
        }

        stopReelInterval() {
            clearInterval(this.reelInterval);
        }

        resetReelInterval() {
            this.stopReelInterval();
            this.startReelInterval();
        }

        handleSwipeGesture() {
            if (this.touchEndX < this.touchStartX - 50) { // Swiped left
                this.showNextImage();
            }
            if (this.touchEndX > this.touchStartX + 50) { // Swiped right
                this.showPrevImage();
            }
        }

        handleTourLinkClick(event) {
            // Guarda el paso actual del tour antes de que el navegador navegue a la nueva página
            if (this.driverObj && this.driverObj.isActivated()) {
                const currentStepIndex = this.driverObj.state.activeIndex;
                localStorage.setItem("currentTourStep", currentStepIndex);
            }
        }

        startTour(retries = 15) {
            if (localStorage.getItem("portfolioTourSeen") === "true") {
                return;
            }
            if (retries <= 0) {
                console.error(
                    "Driver.js no se pudo cargar a tiempo. El tour no se iniciará.",
                );
                return;
            }

            if (window.driver) {
                const driver = window.driver.js.driver;
                this.driverObj = driver({
                    nextBtnText: ">",
                    prevBtnText: "<",
                    doneBtnText: "✕",
                    showProgress: true,
                    allowClose: false,
                    onNextClick: (element, step, { config, state, driver }) => {
                        driver.moveNext();
                        localStorage.setItem(
                            "currentTourStep",
                            state.activeIndex,
                        );
                    },
                    onPrevClick: (element, step, { config, state, driver }) => {
                        
                        driver.movePrevious();
                        localStorage.setItem(
                            "currentTourStep",
                            state.activeIndex,
                        );
                    },
                    steps: [
                        {
                            //intro
                            popover: {
                                title: this.strings.tourStep1Title,
                                description: this.strings.tourStep1Desc,
                            },
                        },
                        {
                            element: ".endpoint-tabs",
                            popover: {
                                title: this.strings.tourStep2Title,
                                description: this.strings.tourStep2Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#personal-data-tab",
                            popover: {
                                title: this.strings.tourStep3Title,
                                description: this.strings.tourStep3Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#experience-tab",
                            popover: {
                                title: this.strings.tourStep4Title,
                                description: this.strings.tourStep4Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#project-tab",
                            popover: {
                                title: this.strings.tourStep5Title,
                                description: this.strings.tourStep5Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#method-select",
                            popover: {
                                title: this.strings.tourStep6Title,
                                description: this.strings.tourStep6Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#url-input",
                            popover: {
                                title: this.strings.tourStep7Title,
                                description: this.strings.tourStep7Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: "#send-button",
                            popover: {
                                title: this.strings.tourStep8Title,
                                description: this.strings.tourStep8Desc,
                                side: "bottom",
                                align: "start",
                            },
                        },
                        {
                            element: ".response-section",
                            popover: {
                                title: this.strings.tourStep9Title,
                                description: this.strings.tourStep9Desc,
                                side: "top",
                                align: "start",
                            },
                        },
                        {
                            popover: {
                                title: this.strings.tourStep10Title,
                                description: `<img src='/assets/bobGif.gif' style='height: 202.5px; width: 270px;' /><span style='font-size: 15px; display: block; margin-top: 10px; text-align: center;'>${this.strings.tourStep10Desc}</span>`,
                            },
                        },
                    ],

                    onDestroyed: () => {
                        localStorage.setItem("portfolioTourSeen", "true");
                        localStorage.removeItem("currentTourStep");
                    },
                });

                const savedTourStep = localStorage.getItem("currentTourStep");
                this.driverObj.drive(
                    savedTourStep ? parseInt(savedTourStep) : 0,
                );
            } else {
                setTimeout(() => this.startTour(retries - 1), 200);
            }
        }
    }

    new EndpointViewer(
        dataToShow,
        clientStrings,
        isHomePage,
        copyableFields,
        showMoreConfig,
    );
</script>

